{
  "actorSpecification": 1,
  "name": "linkedin-to-email",
  "title": "LinkedIn To Email",
  "description": "Find emails from LinkedIn profile URLs in bulk. No LinkedIn cookies required.",
  "version": "1.0",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "LinkedIn To Email Output",
    "description": "LinkedIn profile data with found email addresses.",
    "properties": {
      "results": {
        "type": "string",
        "title": "LinkedIn Profiles",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "ordinal",
              "input_url",
              "linkedin_url",
              "status",
              "stage",
              "first_name",
              "last_name",
              "company_name",
              "company_url",
              "domain",
              "domain_source",
              "email",
              "email_status",
              "profile_source",
              "error",
              "waiting_reason",
              "duplicate_of",
              "request_id",
              "updated_at"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
